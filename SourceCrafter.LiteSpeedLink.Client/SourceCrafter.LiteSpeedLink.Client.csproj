<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Package.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<Configurations>Debug;Release;DEBUG_SG</Configurations>
		<DefineConstants>$(DefineConstants);SG_CONTEXT</DefineConstants>
		<IsTrimmable>true</IsTrimmable>
		<IsAotCompatible>true</IsAotCompatible>
		<Description>LiteSpeedLink client runtime: Memory, UDS, QUIC, TCP and UDP connections for generated clients.</Description>
		<SharedMemoryDir>..\external\SharedMemory\SharedMemory\</SharedMemoryDir>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MemoryPack" Version="1.21.4" />
		<ProjectReference Include="..\SourceCrafter.LiteSpeedLink.Core\SourceCrafter.LiteSpeedLink.Core.csproj" />
		<!-- Transporte Memory enlazado como internal (SG_CONTEXT): no forma parte de la API publica. -->
		<Compile Include="$(SharedMemoryDir)MemChannel.cs;$(SharedMemoryDir)CircularBuffer.cs;$(SharedMemoryDir)SharedBuffer.cs;$(SharedMemoryDir)SharedHeader.cs;$(SharedMemoryDir)FastStructure.cs;$(SharedMemoryDir)MemoryHelpers.cs">
			<Link>SharedMemory\%(Filename)%(Extension)</Link>
		</Compile>
	</ItemGroup>

</Project>
