<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<Configurations>Debug;Release;DEBUG_SG</Configurations>
		<!-- dotnet test -p:TestConstants=NO_POSTGRES (sin pisar DefineConstants de los generadores). -->
		<DefineConstants>$(DefineConstants);$(TestConstants)</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="6.0.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="FluentAssertions" Version="6.12.1" />
		<PackageReference Include="MemoryPack" Version="1.21.4" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="xunit" Version="2.8.1" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LiteSpeedLink.Abstractions\LiteSpeedLink.Abstractions.csproj" />
		<ProjectReference Include="..\SourceCrafter.LiteSpeedLink.Client\SourceCrafter.LiteSpeedLink.Client.csproj" />
		<ProjectReference Include="..\SourceCrafter.LiteSpeedLink.Server\SourceCrafter.LiteSpeedLink.Server.csproj" />
	</ItemGroup>

	<!--
		Arnes Roslyn (GeneratorHarness.cs): el generador de DI (paquete) y el parcial de LiteSpeedLink
		(Helpers) no se cablean como analizadores de este proyecto; solo se fijan sus rutas para
		cargarlos por reflexion y ejecutarlos en memoria.
	-->
	<PropertyGroup>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
		<PackageReference Include="SourceCrafter.DependencyInjection" Version="2.26.282.289" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
		<PackageReference Include="SourceCrafter.DependencyInjection.Metadata" Version="2.26.282.289" />
		<ProjectReference Include="..\SourceCrafter.LiteSpeedLink.ServerGenerator\SourceCrafter.LiteSpeedLink.ServerGenerator.csproj" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\SourceCrafter.LiteSpeedLink.ClientGenerator\SourceCrafter.LiteSpeedLink.ClientGenerator.csproj" ReferenceOutputAssembly="false" />
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>DiGenerator</_Parameter1>
			<_Parameter2>$(PkgSourceCrafter_DependencyInjection)\analyzers\dotnet\cs\SourceCrafter.DependencyInjection.dll</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>LslServerPartial</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)..\SourceCrafter.LiteSpeedLink.ServerGenerator\bin\$(Configuration)\net10.0\SourceCrafter.DependencyInjection.Partial.LiteSpeedLink.Server.dll</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>LslClientPartial</_Parameter1>
			<_Parameter2>$(MSBuildThisFileDirectory)..\SourceCrafter.LiteSpeedLink.ClientGenerator\bin\$(Configuration)\net10.0\SourceCrafter.DependencyInjection.Partial.LiteSpeedLink.Client.dll</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
