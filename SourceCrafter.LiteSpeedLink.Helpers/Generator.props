<Project>

	<!--
		Comun a los generadores parciales de host (ServerGenerator) y cliente (ClientGenerator).
		El generador de DI solo sondea los ensamblados cuyo nombre empieza por
		'SourceCrafter.DependencyInjection.Partial'; cada proyecto fija su AssemblyName con ese prefijo.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
		<PackageVersion>			
			$([System.Convert]::ToUInt16(
				$([MSBuild]::Add(
					$([System.DateTime]::Now.Year),
					-2023
				))
			)).
			$([System.DateTime]::Now.ToString('yy')).
			$([System.DateTime]::Now.DayOfYear).
			$([System.Convert]::ToUInt16(
				$([MSBuild]::Divide(
					$([System.DateTime]::Now.TimeOfDay.TotalMinutes),
					15
				))
			))
		</PackageVersion>
		<Company>AsereHighDev</Company>
		<PackageReadmeFile>ReadMe.md</PackageReadmeFile>
		<Configurations>Debug;Release;DEBUG_SG</Configurations>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<RestoreAdditionalProjectSources>D:\Code\SourceCrafter.DependencyInjection\publish</RestoreAdditionalProjectSources>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
		<Compile Include="D:\Code\SourceCrafter.DependencyInjection\Solution\Interop\PartialGenerationContracts.cs">
			<Link>Interop\%(Filename)%(Extension)</Link>
		</Compile>

		<!--<Compile Include="D:\Code\SourceCrafter.DependencyInjection\SharedMemory\SharedMemory\*.cs">
			<Link>SharedMemory\%(Filename)%(Extension)</Link>
		</Compile>

		<Compile Include="D:\Code\SourceCrafter.DependencyInjection\SharedMemory\SharedMemory\Utilities\*.cs">
			<Link>SharedMemory\Utilities\%(Filename)%(Extension)</Link>
		</Compile>-->
		<Compile Include="D:\Code\SourceCrafter.DependencyInjection\Solution\Metadata\*.cs">
			<Link>Metadata\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Compile>
		<Compile Include="$(MSBuildThisFileDirectory)..\LiteSpeedLink.Abstractions\Helpers.cs">
			<Link>Shared\Abstractions.Helpers.cs</Link>
		</Compile>
		<Compile Include="$(MSBuildThisFileDirectory)*.cs">
			<Link>Shared\%(Filename)%(Extension)</Link>
		</Compile>
	</ItemGroup>

</Project>
