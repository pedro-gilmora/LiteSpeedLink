<Project>

	<!--
		Comun a los generadores parciales de host (ServerGenerator) y cliente (ClientGenerator).
		El generador de DI solo sondea los ensamblados cuyo nombre empieza por
		'SourceCrafter.DependencyInjection.Partial'; cada proyecto fija su AssemblyName con ese prefijo.
	-->
	<Import Project="..\Package.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DEBUG_SG</Configurations>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<!-- El dll va en analyzers/; la unica dependencia publica es el generador DI base, que lo carga. -->
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IncludeSymbols>false</IncludeSymbols>
		<DevelopmentDependency>true</DevelopmentDependency>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<DISolutionDir>$(MSBuildThisFileDirectory)..\external\SourceCrafter.DependencyInjection\Solution\</DISolutionDir>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" PrivateAssets="all" />
		<PackageReference Include="SourceCrafter.DependencyInjection" Version="2.26.282.142" PrivateAssets="none" />
		<Compile Include="$(DISolutionDir)Interop\PartialGenerationContracts.cs">
			<Link>Interop\%(Filename)%(Extension)</Link>
		</Compile>
		<Compile Include="$(DISolutionDir)Metadata\*.cs">
			<Link>Metadata\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Compile>
		<Compile Include="$(MSBuildThisFileDirectory)..\LiteSpeedLink.Abstractions\Helpers.cs">
			<Link>Shared\Abstractions.Helpers.cs</Link>
		</Compile>
		<Compile Include="$(MSBuildThisFileDirectory)*.cs">
			<Link>Shared\%(Filename)%(Extension)</Link>
		</Compile>
		<None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

</Project>
