<Project>

	<!-- Metadatos comunes de los paquetes publicables (Abstractions, Client, Server y los dos generadores). -->
	<PropertyGroup>
		<Version>1.0.0-preview.1</Version>
		<Authors>Pedro Gil Mora</Authors>
		<Company>AsereHighDev</Company>
		<Copyright>Copyright (c) 2024 Pedro Gil Mora</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/pedro-gilmora/LiteSpeedLink</PackageProjectUrl>
		<RepositoryUrl>https://github.com/pedro-gilmora/LiteSpeedLink</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageTags>rpc;source-generator;compile-time;memorypack;shared-memory;tcp;udp;quic</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
