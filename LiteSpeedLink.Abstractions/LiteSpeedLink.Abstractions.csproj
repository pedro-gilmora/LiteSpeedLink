<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;DEBUG_SG</Configurations>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.3.0" />
		<!-- Fork modificado de SharedMemory: fluye como dll transitiva a quien referencie Abstractions, nunca como paquete. -->
		<ProjectReference Include="..\..\SourceCrafter.DependencyInjection\SharedMemory\SharedMemory\SharedMemory.csproj" />
		<Compile Include="D:\Code\SourceCrafter.DependencyInjection\Solution\Metadata\Constants.cs">
			<Link>DISG\%(RecursiveDir)%(Filename)%(Extension)</Link>
		</Compile>
	</ItemGroup>

</Project>
