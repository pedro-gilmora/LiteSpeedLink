<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
		<Configurations>Debug;Release;Pack;DEBUG_SG</Configurations>
		<DefineConstants>$(DefineConstants);SG_CONTEXT</DefineConstants>
		<IsTrimmable>true</IsTrimmable>
		<TrimMode>full</TrimMode>
		<IsAotCompatible>true</IsAotCompatible>
		<PublishTrimmed>true</PublishTrimmed>
		<OptimizationPreference>Size</OptimizationPreference>
		<DebugType>none</DebugType>
		<StripSymbols>true</StripSymbols>
		<TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
		<RestoreAdditionalProjectSources>D:\Code\SourceCrafter.DependencyInjection\publish</RestoreAdditionalProjectSources>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
		<PackageReference Include="MemoryPack" Version="1.21.4" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LiteSpeedLink.Abstractions\LiteSpeedLink.Abstractions.csproj" PrivateAssets="all" />
		<Compile Include="..\Internals\*.cs">
			<Link>InternalsShared\%(Filename)%(Extension)</Link>
		</Compile>
		<!-- Transporte Memory enlazado como internal (SG_CONTEXT): no forma parte de la API publica. -->
		<Compile Include="$(SharedMemoryDir)MemChannel.cs;$(SharedMemoryDir)CircularBuffer.cs;$(SharedMemoryDir)SharedBuffer.cs;$(SharedMemoryDir)SharedHeader.cs;$(SharedMemoryDir)FastStructure.cs;$(SharedMemoryDir)MemoryHelpers.cs">
			<Link>SharedMemory\%(Filename)%(Extension)</Link>
		</Compile>
	</ItemGroup>

	<PropertyGroup>
		<SharedMemoryDir>..\..\SourceCrafter.DependencyInjection\SharedMemory\SharedMemory\</SharedMemoryDir>
	</PropertyGroup>

</Project>
